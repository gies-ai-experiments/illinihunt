# Azure PostgreSQL — point at illinihunt-dev-db for development
DATABASE_URL=postgresql://pgadmin:<password>@illinihunt-dev-db.postgres.database.azure.com:5432/illinihunt?sslmode=require

# Entra ID (UIUC tenant)
AZURE_TENANT_ID=44467e6f-462c-4ea2-823f-7800de5434e3
AZURE_CLIENT_ID=<api app registration client ID>
AZURE_AUDIENCE=<api://<client-id> or your custom App ID URI>

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=<from `az storage account show-connection-string`>
AZURE_STORAGE_CONTAINER=project-images
AZURE_STORAGE_PUBLIC_BASE_URL=https://illinihuntdevsa.blob.core.windows.net/project-images

# Server
PORT=3000
NODE_ENV=development

# Sentry (server-side)
SENTRY_DSN=

# CORS — comma-separated list of allowed origins. Leave empty if behind SWA linked-backend.
CORS_ORIGINS=http://localhost:5173
