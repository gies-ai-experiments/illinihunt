# IlliniHunt frontend env — copy to .env.local for local dev.
# .env.local is gitignored; never commit real secrets.

# ─── Entra ID (UIUC tenant) ────────────────────────────────────────────────
# These are baked into the production bundle at build time.
VITE_AZURE_TENANT_ID=44467e6f-462c-4ea2-823f-7800de5434e3
VITE_AZURE_CLIENT_ID=<api app registration client ID>
# Defaults to VITE_AZURE_CLIENT_ID if omitted; only override if the frontend
# and API are registered as separate Entra apps.
VITE_AZURE_API_CLIENT_ID=<api app registration client ID>

# ─── API endpoint ──────────────────────────────────────────────────────────
# Local dev: point at the local Express server. Production: the Container Apps URL.
VITE_API_URL=http://localhost:3000/api

# ─── Optional: client-side observability ───────────────────────────────────
# Sentry DSN (frontend). Sentry is a no-op when this is empty.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# ─── Legacy Supabase (kept temporarily during cutover) ─────────────────────
# Set these ONLY if you still need the legacy Supabase stack alive locally
# (e.g. for testing rollback). Production no longer reads these.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
