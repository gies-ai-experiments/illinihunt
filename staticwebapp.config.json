{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "trailingSlash": "auto",
  "mimeTypes": {
    ".json": "application/json",
    ".md": "text/markdown; charset=utf-8",
    ".txt": "text/plain; charset=utf-8",
    ".webmanifest": "application/manifest+json"
  },
  "globalHeaders": {
    "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    { "route": "/.well-known/api-catalog", "rewrite": "/well-known-api-catalog.json", "headers": { "content-type": "application/linkset+json" } },

    { "route": "/api", "rewrite": "/api-index.json", "headers": { "content-type": "application/json" } },
    { "route": "/api/", "rewrite": "/api-index.json", "headers": { "content-type": "application/json" } },
    { "route": "/api/*", "rewrite": "/api-error.json", "statusCode": 404, "headers": { "content-type": "application/problem+json" } },

    { "route": "/about", "rewrite": "/about.html" },
    { "route": "/contact", "rewrite": "/contact.html" },
    { "route": "/privacy", "rewrite": "/privacy.html" },
    { "route": "/docs", "rewrite": "/docs.html" },
    { "route": "/developers", "rewrite": "/developers.html" },

    { "route": "/", "rewrite": "/index.html" },
    { "route": "/trending", "rewrite": "/index.html" },
    { "route": "/submit", "rewrite": "/index.html" },
    { "route": "/dashboard", "rewrite": "/index.html" },
    { "route": "/bookmarks", "rewrite": "/index.html" },
    { "route": "/admin", "rewrite": "/index.html" },
    { "route": "/profile/edit", "rewrite": "/index.html" },
    { "route": "/project/*", "rewrite": "/index.html" },
    { "route": "/edit-project/*", "rewrite": "/index.html" },
    { "route": "/user/*", "rewrite": "/index.html" },
    { "route": "/collections", "rewrite": "/index.html" },
    { "route": "/collections/*", "rewrite": "/index.html" }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  }
}
